DATABASE_URL="file:./prisma/dev.db"

# ── Turso (libSQL) 設定 ──────────────────────────────
# Turso を使う場合は以下2つを設定（設定があれば Turso 優先、なければローカル SQLite）
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ── NextAuth 設定 ──────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# ── メール通知設定 ──────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Resend API（SMTPの代わりに使用）
RESEND_API_KEY=""
# 送信元メールアドレス（未設定時は onboarding@resend.dev）
NOTIFICATION_EMAIL=""

# Cronジョブ認証シークレット（任意）
CRON_SECRET=""

# ── Web Push (VAPID) 設定 ──────────────────────────
# npx web-push generate-vapid-keys で生成すること
# VAPID_PRIVATE_KEY は絶対にコミットしないこと（.env のみに記載）
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT: mailto: または https: 形式の連絡先
VAPID_SUBJECT="mailto:admin@example.com"
