// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  passwordHash      String
  name              String
  joinedAt          DateTime?          @map("joined_at") // 入社日
  reminderTime      String             @default("09:00") // 通知時刻 HH:MM
  pushEnabled       Boolean            @default(false)   // プッシュ通知ON/OFF
  createdAt         DateTime           @default(now())
  fiscalYears       FiscalYear[]
  leaveRecords      LeaveRecord[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model FiscalYear {
  id           Int           @id @default(autoincrement())
  userId       Int
  year         Int
  grantedDays  Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRecords LeaveRecord[]

  @@unique([userId, year])
  @@map("fiscal_years")
}

model LeaveRecord {
  id                 Int        @id @default(autoincrement())
  userId             Int
  fiscalYearId       Int
  date               String     // YYYY-MM-DD形式
  type               String     // full / am_half / pm_half / hourly
  hours              Float?     // 時間給の場合のみ
  startTime          String?    // 時間給の開始時刻 (HH:MM)
  endTime            String?    // 時間給の終了時刻 (HH:MM)
  consumedDays       Float      // 消化日数（自動計算）
  note               String?
  notifiedDaybefore  Boolean    @default(false)
  notifiedDayof      Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fiscalYear         FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@map("leave_records")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}
